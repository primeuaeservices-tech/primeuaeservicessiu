# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Resend (Email Service) ──────────────────────────────────────────────────
# Get your key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# From address for outgoing emails (must be a verified domain in Resend)
RESEND_FROM_EMAIL=Prime UAE Services <noreply@primeuaeservices.com>

# Webhook secret for verifying Resend webhook events
RESEND_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Admin Notifications ─────────────────────────────────────────────────────
# Email address that receives new ticket/contact notifications
ADMIN_NOTIFICATION_EMAIL=primeuaeservices@gmail.com

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://primeuaeservices.com
